# Copy this file to .env (already gitignored) and fill in real values.
# NEVER commit a file with real values in it — see SESSION_MEMORY.md's
# "Credentials" section for why this matters.

# Hugging Face token, for `hf auth login` / pushing model artifacts from Phase 3/7/9.
# Get one at https://huggingface.co/settings/tokens (a "write" token if you're pushing).
HF_TOKEN=

# Only needed if Phase 9's medical-fallback generator (google/medgemma-27b-text-it)
# or Phase 7d's CLMBR-T-base is used — both are gated and require this same token
# to have been granted access on their respective model pages first.

# RunPod SSH connection details, filled in per-pod (these change every time you
# rent a new pod, so they don't belong in a committed default anyway).
RUNPOD_HOST=
RUNPOD_PORT=
RUNPOD_SSH_KEY=~/.ssh/id_ed25519
