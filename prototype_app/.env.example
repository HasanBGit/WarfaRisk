# Copy this file to .env and fill in real values. NEVER commit a file with
# a real value in it.

# Preferred backend: MedGemma-27b-text-it via Hugging Face Inference
# Providers, server-proxied so the token never ships in client-side JS (see
# server/app_server.py). Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MEDGEMMA_MODEL=google/medgemma-27b-text-it

# Fallback backend if HF_TOKEN is not set: OpenRouter (any model it hosts,
# default Gemini 2.5 Flash). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
DEFAULT_MODEL=google/gemini-2.5-flash
API_PROVIDER=openrouter

# With neither key configured, the app still works end-to-end: it falls
# back to a deterministic, citation-verified explanation generator (see
# js/api_service.js's generateDeterministicFallback()) rather than silently
# failing or showing nothing.
